# SMTP for the contact form (api/contact.js). Copy to .env locally; set the same vars in Vercel.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 and an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where messages arrive, and the From address (defaults to SMTP_USER)
CONTACT_TO=
CONTACT_FROM=

# Public URL without trailing slash, e.g. https://adrianportillo.dev — used for canonical, hreflang, og:image and sitemap.xml
SITE_URL=
